# Git and version control
.git
.gitignore

# Python cache
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info
.eggs

# Virtual environments
venv
env
.env.local
.venv

# IDE and editors
.vscode
.idea
*.swp
*.swo
*~

# Jupyter notebooks (not needed for production)
*.ipynb
.ipynb_checkpoints

# Documentation files (not needed for runtime)
*.md
!README.md
DEPLOYMENT_CHECKLIST.md
CONTRIBUTING.md

# Test files
tests
test_*
*_test.py

# Temporary files
*.log
*.tmp
*.temp

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Docker files (don't include in Docker build context)
Dockerfile
docker-compose*.yml
.dockerignore

# Streamlit secrets example (keep actual secrets out)
.streamlit/secrets.toml.example

# Other
packages.txt
runtime.txt

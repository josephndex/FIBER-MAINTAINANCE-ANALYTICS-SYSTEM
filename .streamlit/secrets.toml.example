# =====================================================================
# APPLICATION SETTINGS
# =====================================================================

[app]
# Session timeout in minutes (users auto-logout after inactivity)
session_timeout_minutes = 30

# Enable demo mode when database is unavailable
enable_demo_mode = false

# Super admin username (cannot be deleted or demoted)
super_admin_username = "NDERITU"

# =====================================================================
# SECURITY SETTINGS
# =====================================================================

[security]
# Maximum login attempts before temporary lockout
max_login_attempts = 5

# Lockout duration in minutes after max failed attempts
lockout_duration_minutes = 15

# Password requirements
min_password_length = 8
require_special_char = true

# =====================================================================
# EMAIL NOTIFICATIONS (Optional - for SLA alerts)
# =====================================================================

[email]
enabled = false
smtp_server = "smtp.gmail.com"
smtp_port = 587
smtp_username = "your-email@gmail.com"
smtp_password = "your-app-password"
notification_recipients = ["admin@company.africa", "manager@company.africa"]
